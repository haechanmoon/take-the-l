[Unit]
Description=Take the L playground
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=playground
Group=playground
WorkingDirectory=/opt/take-the-l
Environment=NODE_ENV=production
EnvironmentFile=/etc/take-the-l.env
ExecStart=/usr/bin/node-22 --max-old-space-size=384 server/dist/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/take-the-l/server/data
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
